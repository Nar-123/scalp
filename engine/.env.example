# Copy to .env and fill in. Nothing here is a secret by default -- the DRY_RUN
# engine never needs a wallet key. Do NOT put a live private key in this file;
# live signing is not implemented in this pass (see docs/ARCHITECTURE.md).

# --- Solana RPC ---
# Public endpoint works for basic testing but is rate-limited and unreliable
# for onLogs subscriptions. A free-tier Helius/QuickNode/Triton URL is
# strongly recommended for real discovery testing.
RPC_HTTP_URL=https://api.mainnet-beta.solana.com
RPC_WS_URL=wss://api.mainnet-beta.solana.com

# --- Aggregators (optional, enrichment/fallback only) ---
# DexScreener needs no API key. Birdeye is optional; if absent, holder
# concentration still works via direct RPC (getTokenLargestAccounts).
BIRDEYE_API_KEY=

# --- Safety ---
# Must be explicitly set to "false" (and a real Signer must exist, which it
# does not in this pass) before any live order could ever be sent.
DRY_RUN=true

# --- Ledger ---
LEDGER_DB_PATH=./data/ledger.sqlite

# --- Logging ---
LOG_LEVEL=info

# --- Shadow trading (Phase 5/5.1) ---
# Read-only realtime shadow simulation. Default false. Enabling it NEVER signs,
# sends or broadcasts anything and needs no wallet. SHADOW != LIVE TRADING.
SHADOW_TRADING_ENABLED=false

# Read-only quote endpoint. Phase 5.6A: the default is now https://lite-api.jup.ag/swap/v1 because the old
# default (https://quote-api.jup.ag/v6) does not resolve in DNS (measured 2026-09-20 and again in Phase 5.6A).
# Override with JUPITER_BASE_URL (preferred) or JUPITER_QUOTE_BASE_URL.
# JUPITER_BASE_URL=https://lite-api.jup.ag/swap/v1

# --- Native Pump.fun 1-minute SOL volume (Phase 5.4B) ---
# Reads TradeEvents from the existing Pump.fun log subscription (no extra RPC per trade).
# Coverage gaps (disconnect/silence/error) make volume1mSol null, never 0.
PUMPFUN_NATIVE_VOLUME_ENABLED=true
PUMPFUN_RECORD_TRADE_EVENTS=true
PUMPFUN_TRADE_EVENT_RETENTION_HOURS=24

# --- Native Pump.fun bonding-curve market data (Phase 5.5) ---
# Price, liquidity (real SOL in the curve) and exact price impact come from the same event stream.
# For a token on the curve the native snapshot is authoritative; if it cannot be proven the token is
# market_data_unavailable. DexScreener is used only for graduated / non-Pump.fun tokens unless this is true:
PUMPFUN_NATIVE_MARKET_ENABLED=true
PUMPFUN_NATIVE_MAX_SKEW_SEC=5
DEXSCREENER_FALLBACK_FOR_CURVE_TOKENS=false

# --- Providers (Phase 5.6A) ---
# The public keyless endpoints CANNOT serve the safety gate: api.mainnet-beta.solana.com answers
# getTokenLargestAccounts with x-ratelimit-method-limit: 0 (never), publicnode blocks it (403). A configured RPC
# provider that supports getAccountInfo, getTokenLargestAccounts, getParsedTransaction and log subscriptions is
# required. Credentials belong ONLY in the environment (never committed, never logged):
# SOLANA_RPC_URL=https://<provider host>/<path or ?api-key=...>
# SOLANA_RPC_WS_URL=wss://<provider host>/...
# SOLANA_RPC_API_KEY=            # optional, sent as x-api-key
# SOLANA_RPC_FALLBACK_URLS=      # optional, comma separated, explicit, tried in order
# JUPITER_BASE_URL=https://lite-api.jup.ag/swap/v1   # or a keyed endpoint
# JUPITER_API_KEY=               # optional, sent as x-api-key
# JUPITER_FALLBACK_URLS=
# Request discipline (defaults shown by the code): SOLANA_RPC_MAX_RPS, SOLANA_RPC_MAX_CONCURRENT, SOLANA_RPC_TIMEOUT_MS,
# SOLANA_RPC_MAX_RETRIES, JUPITER_MAX_RPS, JUPITER_MAX_CONCURRENT, JUPITER_TIMEOUT_MS, JUPITER_MAX_RETRIES,
# JUPITER_QUOTE_CACHE_TTL_MS (max 10000)

# --- Holder-concentration safeguards (Phase 5.6E, optional; both OFF when unset) ---
# The concentration limit itself is unchanged (60%). For a live Pump.fun bonding curve whose vault is verified on chain, the vault is
# excluded and the top-10 is measured against the circulating supply. These two extra safeguards have NO default value:
# SAFETY_MIN_CIRCULATING_SHARE_PCT=      # reject when circulating supply is below this % of total supply (0-100)
# SAFETY_MIN_VISIBLE_HOLDERS=            # reject when fewer non-vault accounts hold tokens (at most 19 are visible on a live curve)
